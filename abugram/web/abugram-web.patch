+/**
+ * Abugram's own ads: one card at the top of the chat list, labelled as an ad, from the Abugram relay's /ads
+ * (managed on the Abugram admin page). A view is counted once per start, a click through /go/<id>. The card can
+ * stays while its campaign runs (by hours, days or views). Telegram's own sponsored messages in channels are left as they are.
+ */
+type AbugramAd = {id: number, title: string, text: string, image: string, url: string};
+
+
+function relayBase(): string {
+  const relay: string = import.meta.env.VITE_ABUGRAM_RELAY || '';
+  return relay.replace(/^wss:/i, 'https:').replace(/\/+$/, '');
+}
+
+
+export default async function mountAbugramAds(container: HTMLElement) {
+  return mountAbugramAdCard(container, 'list');
+}
+
+export async function mountAbugramAdCard(container: HTMLElement, place: 'list' | 'chat') {
+  const base = relayBase();
+  if(!base || !container) return;
+
+  let ads: AbugramAd[];
+  try {
+    const response = await fetch(base + '/ads', {cache: 'no-store'});
+    ads = (await response.json()).ads || [];
+  } catch(err) {
+    return;
+  }
+  if(!ads.length) return;
+
+  const ad = ads[Math.floor(Math.random() * ads.length)];
+  const card = document.createElement('div');
+  card.className = 'abugram-ad';
+  card.setAttribute('role', 'link');
+  card.tabIndex = 0;
+
+  if(/^https:\/\//i.test(ad.image)) {
+    const img = document.createElement('img');
+    img.className = 'abugram-ad-image';
+    img.src = ad.image;
+    img.alt = '';
+    img.loading = 'lazy';
+    card.append(img);
+  }
+
+  const body = document.createElement('div');
+  body.className = 'abugram-ad-body';
+  const label = document.createElement('div');
+  label.className = 'abugram-ad-label';
+  label.textContent = 'Reklama · Реклама';
+  body.append(label);
+  if(ad.title) {
+    const title = document.createElement('div');
+    title.className = 'abugram-ad-title';
+    title.textContent = ad.title;
+    body.append(title);
+  }
+  if(ad.text) {
+    const text = document.createElement('div');
+    text.className = 'abugram-ad-text';
+    text.textContent = ad.text;
+    body.append(text);
+  }
+  card.append(body);
+
+
+  const open = () => {
+    if(!ad.url) return;
+    // * the relay counts the click on /go/<id>; the link itself opens here, a t.me one inside the app
+    fetch(base + '/go/' + ad.id, {mode: 'no-cors', redirect: 'manual', keepalive: true}).catch(() => {});
+    import('@lib/appImManager').then(({default: appImManager}) => appImManager.openUrl(ad.url)).catch(() => {
+      window.open(ad.url, '_blank', 'noopener');
+    });
+  };
+  card.addEventListener('click', open);
+  card.addEventListener('keydown', (e) => {
+    if(e.key === 'Enter') open();
+  });
+
+  if(place === 'chat') {
+    container.append(card);
+  } else {
+    // * under the folder tabs, above the chats (Telegram's place for its own sponsored card)
+    const folders = container.querySelector('#folders-container');
+    if(folders) folders.after(card); else container.prepend(card);
+  }
+  fetch(base + '/ads/seen', {method: 'POST', body: JSON.stringify({ids: [ad.id]}), keepalive: true}).catch(() => {});
+}
diff --git a/src/lib/abugram/chatAd.ts b/src/lib/abugram/chatAd.ts
