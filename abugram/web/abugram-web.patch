+/**
+ * Abugram feature switches, kept in `settings.abugram` of the account state (Settings → Abugram).
+ * Everything is off by default except hiding sponsored messages, as in Abugram for Android.
+ */
+export type AbugramSettings = {
+  ghostRead: boolean,
+  ghostTyping: boolean,
+  ghostOnline: boolean,
+  ghostStories: boolean,
+  keepDeleted: boolean,
+  hideSponsored: boolean,
+  hideStories: boolean,
+  confirmCalls: boolean,
+  showSeconds: boolean
+};
+
+export const ABUGRAM_DEFAULTS: AbugramSettings = {
+  ghostRead: false,
+  ghostTyping: false,
+  ghostOnline: false,
+  ghostStories: false,
+  keepDeleted: false,
+  hideSponsored: true,
+  hideStories: false,
+  confirmCalls: true,
+  showSeconds: true
+};
+
+export function getAbugramSettings(settings: {abugram?: Partial<AbugramSettings>} | undefined): AbugramSettings {
+  return {...ABUGRAM_DEFAULTS, ...(settings?.abugram || {})};
+}
+
+export type AbugramFilterResult = {block: false} | {block: true, result: any};
+
+/**
+ * Decides, before a request is sent, whether a privacy switch holds it back on this device. A held-back request
+ * resolves with the answer the server would give when nothing changed, so the callers carry on as usual (the chat
+ * still turns read here; only the other side is not told). `account.updateStatus` is sent, but always as offline.
+ */
+export function abugramFilterRequest(method: string, params: any, s: AbugramSettings, currentPts: number): AbugramFilterResult {
+  if(s.ghostRead) {
+    switch(method) {
+      case 'messages.readHistory':
+      case 'messages.readMessageContents':
+        return {block: true, result: {_: 'messages.affectedMessages', pts: currentPts, pts_count: 0}};
+      case 'channels.readHistory':
+      case 'channels.readMessageContents':
+      case 'messages.readDiscussion':
+        return {block: true, result: true};
+    }
+  }
+  if(s.ghostTyping && method === 'messages.setTyping') {
+    return {block: true, result: true};
+  }
+  if(s.ghostOnline && method === 'account.updateStatus' && params) {
+    params.offline = true;
+  }
+  if(s.ghostStories) {
+    if(method === 'stories.readStories') return {block: true, result: []};
+    if(method === 'stories.incrementStoryViews') return {block: true, result: true};
+  }
+  if(s.hideSponsored && method === 'messages.getSponsoredMessages') {
+    return {block: true, result: {_: 'messages.sponsoredMessagesEmpty'}};
+  }
+  return {block: false};
+}
