diff --git a/src/components/sidebarLeft/tabs/abugram.tsx b/src/components/sidebarLeft/tabs/abugram.tsx
new file mode 100644
index 0000000..427eadd
--- /dev/null
+++ b/src/components/sidebarLeft/tabs/abugram.tsx
@@ -0,0 +1,136 @@
+import CheckboxFieldTsx from '@components/checkboxFieldTsx';
+import Row from '@components/rowTsx';
+import Section from '@components/section';
+import {ABUGRAM_DEFAULTS, AbugramSettings} from '@lib/abugram/settings';
+import {i18n, LangPackKey} from '@lib/langPack';
+import {useAppSettings} from '@stores/appSettings';
+import {useSuperTab} from '@components/solidJsTabs/superTabProvider';
+import {toastNew} from '@components/toast';
+import I18n from '@lib/langPack';
+import {createSignal, For, onCleanup, onMount, Show} from 'solid-js';
+import {abugramWatchSockets, AbugramSocketRecord} from '@lib/abugram/netStats';
+import {abugramAccess, ABUGRAM_ADMIN_URL, loadAbugramAccess} from '@lib/abugram/access';
+
+/** Settings → Abugram: the same switches as in Abugram for Android. */
+const AbugramTab = () => {
+  const [tab] = useSuperTab();
+  const [appSettings, setAppSettings] = useAppSettings();
+  const [creating, setCreating] = createSignal(false);
+  const [sockets, setSockets] = createSignal<AbugramSocketRecord[]>([]);
+  const [now, setNow] = createSignal(Date.now());
+  onMount(() => {
+    loadAbugramAccess();
+    const stop = abugramWatchSockets((records) => {
+      setSockets(records.slice().reverse().slice(0, 20));
+      setNow(Date.now());
+    });
+    onCleanup(stop);
+  });
+  const kb = (bytes: number) => (bytes / 1024).toFixed(1) + ' KB';
+  const describe = (r: AbugramSocketRecord) => {
+    const lived = (((r.closedAt ?? now()) - r.openedAt) / 1000).toFixed(1) + 's';
+    return `#${r.id} ${r.kind === 'https' ? 'HTTPS' : 'WS'} DC${r.dcId} · ${lived} · ⬇${kb(r.bytesIn)} ⬆${kb(r.bytesOut)} · ${r.closedAt ? r.reason : 'ochiq'}`;
+  };
+
+  const createTabs = async() => {
+    if(creating()) return;
+    setCreating(true);
+    try {
+      const t = (key: LangPackKey) => I18n.format(key, true);
+      const result = await tab.managers.filtersStorage.abugramCreateTabs({
+        personal: t('Abugram.Tab.Personal'),
+        groups: t('Abugram.Tab.Groups'),
+        publicGroups: t('Abugram.Tab.PublicGroups'),
+        channels: t('Abugram.Tab.Channels'),
+        bots: t('Abugram.Tab.Bots')
+      });
+      if(result.limited) {
+        toastNew({langPackKey: 'Abugram.Tabs.Limit'});
+      } else if(!result.made) {
+        toastNew({langPackKey: 'Abugram.Tabs.None'});
+      } else {
+        toastNew({langPackKey: 'Abugram.Tabs.Done', langPackArguments: ['' + result.made]});
+      }
+    } catch(err) {
+      toastNew({langPackKey: 'Error.AnError'});
+    } finally {
+      setCreating(false);
+    }
+  };
+
+  const get = (key: keyof AbugramSettings) => appSettings.abugram?.[key] ?? ABUGRAM_DEFAULTS[key];
+  const set = (key: keyof AbugramSettings, value: boolean) => {
+    if(!appSettings.abugram) {
+      setAppSettings('abugram', {...ABUGRAM_DEFAULTS, [key]: value});
+    } else {
+      setAppSettings('abugram', key, value);
+    }
+  };
+
+  const Toggle = (props: {key: keyof AbugramSettings, title: LangPackKey, subtitle: LangPackKey}) => (
+    <Row>
+      <Row.CheckboxFieldToggle>
+        <CheckboxFieldTsx toggle checked={get(props.key)} onChange={(checked) => set(props.key, checked)} />
+      </Row.CheckboxFieldToggle>
+      <Row.Title>{i18n(props.title)}</Row.Title>
+      <Row.Subtitle>{i18n(props.subtitle)}</Row.Subtitle>
+    </Row>
+  );
+
+  return (
+    <>
+      <Section name="Abugram.Tabs" caption="Abugram.Tabs.Info">
+        <Row clickable={createTabs} disabled={creating()}>
+          <Row.Icon icon="folder" />
+          <Row.Title>{i18n('Abugram.Tabs.Create')}</Row.Title>
+          <Row.Subtitle>{i18n('Abugram.Tabs.Create.Sub')}</Row.Subtitle>
+        </Row>
+      </Section>
+      <Show when={abugramAccess().admin}>
+        <Section>
+          <Row clickable={() => window.open(ABUGRAM_ADMIN_URL, '_blank', 'noopener')}>
+            <Row.Icon icon="settings" />
+            <Row.Title>{i18n('Abugram.Admin')}</Row.Title>
+            <Row.Subtitle>{i18n('Abugram.Admin.Sub')}</Row.Subtitle>
+          </Row>
+        </Section>
+      </Show>
+      <Show when={abugramAccess().ghost}>
+      <Section name="Abugram.Ghost" caption="Abugram.Ghost.Info">
+        <Toggle key="ghostRead" title="Abugram.GhostRead" subtitle="Abugram.GhostRead.Sub" />
+        <Toggle key="ghostTyping" title="Abugram.GhostTyping" subtitle="Abugram.GhostTyping.Sub" />
+        <Toggle key="ghostOnline" title="Abugram.GhostOnline" subtitle="Abugram.GhostOnline.Sub" />
+        <Toggle key="ghostStories" title="Abugram.GhostStories" subtitle="Abugram.GhostStories.Sub" />
+      </Section>
+      </Show>
+      <Section name="Abugram.Messages" caption="Abugram.Messages.Info">
+        <Toggle key="keepDeleted" title="Abugram.KeepDeleted" subtitle="Abugram.KeepDeleted.Sub" />
+      </Section>
+      <Section name="Abugram.Look">
+        <Toggle key="hideStories" title="Abugram.HideStories" subtitle="Abugram.HideStories.Sub" />
+        <Toggle key="showSeconds" title="Abugram.ShowSeconds" subtitle="Abugram.ShowSeconds.Sub" />
+        <Row>
+          <Row.CheckboxFieldToggle>
+            <CheckboxFieldTsx toggle checked={appSettings.showPeerIds} onChange={(checked) => setAppSettings('showPeerIds', checked)} />
+          </Row.CheckboxFieldToggle>
+          <Row.Title>{i18n('Abugram.ShowIds')}</Row.Title>
+          <Row.Subtitle>{i18n('Abugram.ShowIds.Sub')}</Row.Subtitle>
+        </Row>
+      </Section>
+      <Section name="Abugram.Diag" caption="Abugram.Diag.Info">
+        <Show when={sockets().length} fallback={<Row><Row.Title>{i18n('Abugram.Diag.Empty')}</Row.Title></Row>}>
+          <For each={sockets()}>{(r) => (
+            <Row>
+              <Row.Title><span style="font-size: 0.85em; font-variant-numeric: tabular-nums">{describe(r)}</span></Row.Title>
+            </Row>
+          )}</For>
+        </Show>
+      </Section>
+      <Section name="Abugram.Calls">
+        <Toggle key="confirmCalls" title="Abugram.ConfirmCalls" subtitle="Abugram.ConfirmCalls.Sub" />
+      </Section>
+    </>
+  );
+};
+
+export default AbugramTab;
