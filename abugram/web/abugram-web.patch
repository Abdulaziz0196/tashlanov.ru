+  // wss://<host label>.web.telegram.org/<path>; MTProto stays end-to-end encrypted to Telegram.
+  const relay = getAbugramRelay();
+  if(relay) {
+    return `${relay}/${App.suffix.toLowerCase()}ws${dcId}${suffix}/${path}`;
+  }
   const chosenServer = `wss://${App.suffix.toLowerCase()}ws${dcId}${suffix}.web.telegram.org/${path}`;
 
   return chosenServer;
