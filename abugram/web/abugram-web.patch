diff --git a/src/lib/abugram/access.ts b/src/lib/abugram/access.ts
new file mode 100644
index 0000000..1c15c60
--- /dev/null
+++ b/src/lib/abugram/access.ts
@@ -0,0 +1,51 @@
+/**
+ * Abugram: what this account may use, as the Abugram admin set it (relay /access): ghost mode for the accounts
+ * allowed it, the admin page link for admins. Everyone else gets neither; their ghost switches have no effect.
+ */
+import {createRoot, createSignal} from 'solid-js';
+import rootScope from '@lib/rootScope';
+import {setAppSettings, appSettings} from '@stores/appSettings';
+
+export type AbugramAccess = {ghost: boolean, admin: boolean};
+
+const [access, setAccess] = createRoot(() => createSignal<AbugramAccess>({ghost: false, admin: false}));
+export const abugramAccess = access;
+
+export const ABUGRAM_ADMIN_URL = 'https://abdulaziz0196.github.io/tashlanov.ru/abugram/admin.html';
+
+function relayBase(): string {
+  const relay: string = import.meta.env.VITE_ABUGRAM_RELAY || '';
+  return relay.replace(/^wss:/i, 'https:').replace(/\/+$/, '');
+}
+
+export async function loadAbugramAccess() {
+  const base = relayBase();
+  const uid = rootScope.myId ? rootScope.myId.toUserId() : 0;
+  if(!base || !uid) return;
+  // * counted once a day as an Abugram user (the relay keeps only a hash of the ID) - for the user counts on the stats page
+  const helloKey = 'abugram.hello.' + uid;
+  const today = new Date().toISOString().slice(0, 10);
+  let said: string;
+  try {
+    said = localStorage.getItem(helloKey);
+  } catch(err) {}
+  if(said !== today) {
+    fetch(base + '/hello', {method: 'POST', body: JSON.stringify({uid, platform: 'web'}), keepalive: true}).then(() => {
+      try {
+        localStorage.setItem(helloKey, today);
+      } catch(err) {}
+    }).catch(() => {});
+  }
+
+  try {
+    const response = await fetch(base + '/access?uid=' + uid, {cache: 'no-store'});
+    const result = await response.json();
+    const value: AbugramAccess = {ghost: !!result.ghost, admin: !!result.admin};
+    setAccess(value);
+    // * the request filter (in the MTProto worker) honours the ghost switches only while this is set
+    if(!!appSettings.abugram?.ghostAllowed !== value.ghost) {
+      if(appSettings.abugram) setAppSettings('abugram', 'ghostAllowed', value.ghost);
+      else setAppSettings('abugram', {ghostAllowed: value.ghost});
+    }
+  } catch(err) {}
+}
