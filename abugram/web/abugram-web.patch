+  /**
+   * Abugram: makes the chat tabs Personal, Groups, Public groups, Channels and Bots as ordinary folders, so they show
+   * on every device of the account. Telegram's folder flags cannot tell a public group from a private one, so the
+   * public groups are listed by name (at most 100, as a folder holds): "Groups" leaves them out, "Public groups" has
+   * them. A tab whose title a folder has already is skipped. Returns how many were made, and whether the folder limit
+   * stopped the rest.
+   */
+  public async abugramCreateTabs(titles: {personal: string, groups: string, publicGroups: string, channels: string, bots: string}) {
+    const publicGroups: InputPeer[] = [];
+    const publicGroupIds = new Set<PeerId>();
+    let offsetDate = 0, offsetId = 0, offsetPeer: InputPeer = {_: 'inputPeerEmpty'};
+    for(let page = 0; page < 10 && publicGroups.length < 100; ++page) {
+      const res = await this.apiManager.invokeApi('messages.getDialogs', {
+        offset_date: offsetDate,
+        offset_id: offsetId,
+        offset_peer: offsetPeer,
+        limit: 100,
+        hash: '0'
+      });
+      if(res._ === 'messages.dialogsNotModified') break;
+      this.appUsersManager.saveApiUsers(res.users);
+      this.appChatsManager.saveApiChats(res.chats);
+
+      const dialogPeerIds = new Set(res.dialogs.map((dialog) => this.appPeersManager.getPeerId((dialog as any).peer)).filter(Boolean));
+      for(const chat of res.chats) {
+        if(chat._ !== 'channel' || !chat.pFlags.megagroup) continue;
+        const isPublic = !!chat.username || !!chat.usernames?.some((username) => username.pFlags.active);
+        const peerId = chat.id.toPeerId(true);
+        if(!isPublic || !dialogPeerIds.has(peerId) || publicGroupIds.has(peerId)) continue;
+        publicGroupIds.add(peerId);
+        publicGroups.push(this.appPeersManager.getInputPeerById(peerId));
+        if(publicGroups.length >= 100) break;
+      }
+
+      if(res._ !== 'messages.dialogsSlice' || res.dialogs.length < 100) break;
+      const last = res.dialogs[res.dialogs.length - 1] as any;
+      const lastPeerId = this.appPeersManager.getPeerId(last.peer);
+      const lastMessage = res.messages.find((message) => (message as any).id === last.top_message &&
+        this.appPeersManager.getPeerId((message as any).peer_id) === lastPeerId);
+      offsetDate = (lastMessage as any)?.date || 0;
+      offsetId = last.top_message;
+      offsetPeer = this.appPeersManager.getInputPeerById(lastPeerId);
+    }
+
+    const make = (title: string, emoticon: string, pFlags: DialogFilter.dialogFilter['pFlags'], include: InputPeer[] = [], exclude: InputPeer[] = []): MyDialogFilter => ({
+      ...copy(LOCAL_FILTER),
+      pFlags,
+      title: {_: 'textWithEntities', text: title, entities: []},
+      emoticon,
+      include_peers: include,
+      exclude_peers: exclude,
+      includePeerIds: include.map((peer) => this.appPeersManager.getPeerId(peer)),
+      excludePeerIds: exclude.map((peer) => this.appPeersManager.getPeerId(peer))
+    } as MyDialogFilter);
+
+    const tabs: MyDialogFilter[] = [
+      make(titles.personal, '👤', {contacts: true, non_contacts: true}),
+      make(titles.groups, '👥', {groups: true}, [], publicGroups),
+      publicGroups.length ? make(titles.publicGroups, '👥', {}, publicGroups) : undefined,
+      make(titles.channels, '📢', {broadcasts: true}),
+      make(titles.bots, '🤖', {bots: true})
+    ].filter(Boolean);
+
+    const existing = new Set(Object.values(this.filters).map((filter) => {
+      const title = (filter as DialogFilter.dialogFilter).title;
+      return (typeof(title) === 'string' ? title : title?.text || '').trim().toLowerCase();
+    }));
+
+    // * made last to first, each put right after "All chats", so they line up in the order above
+    const limit = await this.apiManager.getLimit('folders');
+    const toMake = tabs.filter((tab) => !existing.has(tab.title.text.toLowerCase()));
+    const room = limit - Object.keys(this.filters).filter((id) => !REAL_FOLDERS.has(+id)).length;
+    let limited = toMake.length > room;
+    toMake.splice(Math.max(0, room));
+    let made = 0;
+    for(const tab of toMake.reverse()) {
+      try {
+        await this.createDialogFilter(tab, true);
+        ++made;
+      } catch(err) {
+        if((err as ApiError)?.type === 'DIALOG_FILTERS_TOO_MUCH' || (err as ApiError)?.type === 'FILTERS_TOO_MUCH') {
+          limited = true;
+          break;
+        }
+        throw err;
+      }
+    }
+
+    return {made, limited, publicGroups: publicGroups.length};
+  }
+
   public getSuggestedDialogsFilters() {
     return this.apiManager.invokeApi('messages.getSuggestedDialogFilters');
   }
