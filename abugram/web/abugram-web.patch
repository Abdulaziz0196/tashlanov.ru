@@ -0,0 +1,70 @@
+/**
+ * Abugram: the music that is playing stays on screen as a bar at the top of the app, like Telegram's mini player.
+ * It shows the track, plays or pauses it, and closes it. Tapping the title opens the chat the track came from.
+ * Voice messages and round videos do not show it; music and audio files do.
+ */
+import appMediaPlaybackController from '@components/appMediaPlaybackController';
+import appImManager from '@lib/appImManager';
+import rootScope from '@lib/rootScope';
+
+const ICON_PLAY = '▶';
+const ICON_PAUSE = '❚❚';
+
+function trackTitle(doc: any): string {
+  const title = doc?.attributes?.find?.((a: any) => a._ === 'documentAttributeAudio');
+  const name = title?.title || doc?.file_name || '';
+  const artist = title?.performer || '';
+  return artist ? artist + ' — ' + name : name;
+}
+
+export function mountAbugramMiniPlayer(anchor: HTMLElement) {
+  const bar = document.createElement('div');
+  bar.className = 'abugram-mini-player';
+  bar.hidden = true;
+  bar.innerHTML = '<button type="button" class="abugram-mini-toggle" aria-label="Play"></button>' +
+    '<button type="button" class="abugram-mini-title"></button>' +
+    '<button type="button" class="abugram-mini-close" aria-label="Close">×</button>';
+  const toggle = bar.querySelector('.abugram-mini-toggle') as HTMLButtonElement;
+  const titleBtn = bar.querySelector('.abugram-mini-title') as HTMLButtonElement;
+  const close = bar.querySelector('.abugram-mini-close') as HTMLButtonElement;
+  anchor.after(bar);
+
+  let current: {message: any, doc: any, peerId: any} | undefined;
+  const show = (details: any) => {
+    const doc = details?.doc;
+    const isVoice = doc && (doc.type === 'voice' || doc.type === 'round');
+    if(!details || !doc || isVoice) {
+      bar.hidden = true;
+      current = undefined;
+      return;
+    }
+    current = {message: details.message, doc, peerId: details.message?.peerId};
+    titleBtn.textContent = trackTitle(doc) || 'Musiqa';
+    toggle.textContent = ICON_PAUSE;
+    bar.hidden = false;
+  };
+
+  appMediaPlaybackController.addEventListener('play', (details: any) => show(details));
+  appMediaPlaybackController.addEventListener('pause', () => {
+    toggle.textContent = ICON_PLAY;
+  });
+  appMediaPlaybackController.addEventListener('stop', () => {
+    bar.hidden = true;
+    current = undefined;
+  });
+
+  toggle.addEventListener('click', (e) => {
+    e.stopPropagation();
+    appMediaPlaybackController.toggle();
+  });
+  close.addEventListener('click', (e) => {
+    e.stopPropagation();
+    appMediaPlaybackController.stop();
+  });
+  titleBtn.addEventListener('click', () => {
+    if(!current?.peerId) return;
+    appImManager.setInnerPeer({peerId: current.peerId, lastMsgId: current.message?.mid});
+  });
+
+  return bar;
+}
