@@ -49,6 +49,15 @@ export function assertValidDcId(dcId: DcId): DcId {
   return +dcId as DcId;
 }
 
+function getAbugramRelay(): string {
+  let relay: string = import.meta.env.VITE_ABUGRAM_RELAY || '';
+  try {
+    relay = (typeof(localStorage) !== 'undefined' && localStorage.getItem('abugram.relay')) || relay;
+  } catch(err) {}
+  relay = relay.trim().replace(/\/+$/, '');
+  return /^wss:\/\/[a-z0-9.-]+(\/[a-z0-9._-]+)*$/i.test(relay) ? relay : '';
+}
+
 export function constructTelegramWebSocketUrl(_dcId: DcId, connectionType: ConnectionType, premium?: boolean) {
   if(!import.meta.env.VITE_MTPROTO_HAS_WS) {
     return;
@@ -57,6 +66,13 @@ export function constructTelegramWebSocketUrl(_dcId: DcId, connectionType: Conne
   const dcId = assertValidDcId(_dcId);
   const suffix = getTelegramConnectionSuffix(connectionType);
   const path = connectionType !== 'client' ? 'apiws' + TEST_SUFFIX + (premium ? PREMIUM_SUFFIX : '') : ('apiws' + TEST_SUFFIX);
+  // Abugram: an optional WebSocket relay (VITE_ABUGRAM_RELAY, or localStorage 'abugram.relay' to test one)
+  // for networks that block *.web.telegram.org. The relay forwards /<host label>/<path> to
+  // wss://<host label>.web.telegram.org/<path>; MTProto stays end-to-end encrypted to Telegram.
+  const relay = getAbugramRelay();
