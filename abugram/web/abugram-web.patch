@@ -0,0 +1,39 @@
+/**
+ * Abugram: the ad card at the top of a chat (private chats, groups, bots and channels), under the chat header.
+ * It is the same card as at the top of the chat list (lib/abugram/ads), and is counted the same way.
+ */
+import {mountAbugramAdCard} from '@lib/abugram/ads';
+
+let mounted: {chatId: number, el: HTMLElement};
+
+export function mountChatAd(chat: any, peerId: any, managers: any) {
+  if(mounted) {
+    mounted.el.remove();
+    mounted = undefined;
+  }
+  // * inside the messages, at the very top: the same place as Telegram's own sponsored message, so it is never hidden
+  // * under the header, and it scrolls with the chat
+  const inner: HTMLElement = (chat as any).bubbles?.chatInner;
+  if(!inner) return;
+  const el = document.createElement('div');
+  el.className = 'abugram-chat-ad-host';
+  inner.prepend(el);
+  mounted = {chatId: 0, el};
+  // * the card sticks just under the header and its pinned-message plate, which cover the top of the messages
+  const topbar: HTMLElement = (chat as any).topbar?.container;
+  const pin = () => {
+    if(topbar) el.style.top = topbar.offsetHeight + 'px';
+  };
+  pin();
+  if(topbar && typeof ResizeObserver !== 'undefined') {
+    const ro = new ResizeObserver(pin);
+    ro.observe(topbar);
+  }
+  mountAbugramAdCard(el, 'chat');
+  // * the messages are drawn after the chat is opened and can clear the top: put the card back if they did
+  for(const delay of [600, 1800]) {
+    setTimeout(() => {
+      if(!el.isConnected && inner.isConnected) inner.prepend(el);
+    }, delay);
+  }
+}
diff --git a/src/lib/abugram/netStats.ts b/src/lib/abugram/netStats.ts
new file mode 100644
index 0000000..f5e7bb5
--- /dev/null
+++ b/src/lib/abugram/netStats.ts
@@ -0,0 +1,69 @@
+/**
+ * Abugram: what each relayed connection did (how long it lived, what it carried, why it ended), kept where the
+ * connections live (the MTProto worker) and read by Settings → Abugram over a BroadcastChannel, so a network that
+ * freezes or cuts connections can be told from the screen.
+ */
+export type AbugramSocketRecord = {
+  id: number,
+  kind?: 'ws' | 'https',
+  dcId: number,
+  openedAt: number,
+  closedAt?: number,
+  bytesIn: number,
+  bytesOut: number,
+  reason?: string
+};
+
+const CHANNEL = 'abugram-net';
+const KEEP = 40;
+const records: AbugramSocketRecord[] = [];
+let nextId = 1;
+let channel: BroadcastChannel;
+
+function getChannel() {
+  if(channel === undefined) {
+    try {
+      channel = new BroadcastChannel(CHANNEL);
+      channel.onmessage = (event) => {
+        if(event.data?.type === 'get') channel.postMessage({type: 'all', records});
+      };
+    } catch(err) {
+      channel = null;
+    }
+  }
+  return channel;
+}
+
+export function abugramSocketOpened(dcId: number, kind: 'ws' | 'https' = 'ws'): AbugramSocketRecord {
+  const record: AbugramSocketRecord = {id: nextId++, kind, dcId, openedAt: Date.now(), bytesIn: 0, bytesOut: 0};
+  records.push(record);
+  if(records.length > KEEP) records.shift();
+  getChannel()?.postMessage({type: 'all', records});
+  return record;
+}
+
+export function abugramSocketClosed(record: AbugramSocketRecord, reason: string) {
+  if(!record || record.closedAt) return;
+  record.closedAt = Date.now();
+  record.reason = reason;
+  getChannel()?.postMessage({type: 'all', records});
+}
+
+/** For the settings screen: calls `onRecords` with every report, returns the unsubscribe. */
+export function abugramWatchSockets(onRecords: (records: AbugramSocketRecord[]) => void) {
+  let c: BroadcastChannel;
+  try {
+    c = new BroadcastChannel(CHANNEL);
+  } catch(err) {
+    return () => {};
+  }
+  c.onmessage = (event) => {
+    if(event.data?.type === 'all') onRecords(event.data.records);
+  };
+  c.postMessage({type: 'get'});
+  const interval = setInterval(() => c.postMessage({type: 'get'}), 2000);
+  return () => {
+    clearInterval(interval);
+    c.close();
+  };
+}
