+.abugram-chat-ad-host {
+  position: sticky;
+  top: 0;
+  z-index: 3;
+  padding: 6px 0 4px;
+  background: linear-gradient(to bottom, var(--surface-color) 70%, transparent);
+}
+
+.abugram-ad {
+  position: relative;
+  flex: 0 0 auto;
+  display: flex;
+  align-items: center;
+  gap: .75rem;
+  margin: .5rem .75rem;
+  padding: .75rem 2.5rem .75rem .75rem;
+  border-radius: 16px;
+  background: color-mix(in srgb, var(--surface-color) 92%, transparent);
+  -webkit-backdrop-filter: blur(20px) saturate(170%);
+  backdrop-filter: blur(20px) saturate(170%);
+  box-shadow: 0 1px 0 color-mix(in srgb, var(--primary-text-color) 8%, transparent), 0 4px 16px rgba(0, 0, 0, .12);
+  color: var(--primary-text-color);
+  cursor: pointer;
+  -webkit-tap-highlight-color: transparent;
+  transition: transform .15s ease, opacity .15s ease;
+
+  &:active {
+    transform: scale(.985);
+    opacity: .9;
+  }
+}
+
+.abugram-ad-image {
+  flex: 0 0 auto;
+  width: 46px;
+  height: 46px;
+  border-radius: 12px;
+  object-fit: cover;
+}
+
+.abugram-ad-body {
+  min-width: 0;
+}
+
+.abugram-ad-label {
+  display: inline-block;
+  margin-bottom: 2px;
+  padding: 1px 6px;
+  border-radius: 6px;
+  background: color-mix(in srgb, var(--primary-color) 16%, transparent);
+  font-size: .6875rem;
+  font-weight: 600;
+  color: var(--primary-color);
+}
+
+.abugram-ad-title {
+  font-weight: 600;
+  font-size: .9375rem;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.abugram-ad-text {
+  font-size: .8125rem;
+  color: var(--secondary-text-color);
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+
+.abugram-ad-close {
+  position: absolute;
+  top: 50%;
+  inset-inline-end: .5rem;
+  transform: translateY(-50%);
+  width: 26px;
+  height: 26px;
+  border: 0;
+  border-radius: 50%;
+  background: color-mix(in srgb, var(--primary-text-color) 10%, transparent);
+  color: var(--secondary-text-color);
+  font-size: 1rem;
+  line-height: 1;
+  cursor: pointer;
+}
+
+// * Abugram: the music mini player at the top (components/abugramMiniPlayer)
+.abugram-mini-player {
+  position: relative;
+  z-index: 6;
+  margin: 8px 10px 4px;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  height: 56px;
+  padding: 0 8px 0 7px;
+  border-radius: 20px;
+  background: color-mix(in srgb, var(--surface-color) 80%, transparent);
+  -webkit-backdrop-filter: blur(20px) saturate(170%);
+  backdrop-filter: blur(20px) saturate(170%);
+  box-shadow: 0 6px 22px rgba(0, 0, 0, .22), inset 0 0 0 .5px color-mix(in srgb, var(--primary-text-color) 12%, transparent);
+
+  &[hidden] {
+    display: none;
+  }
+
+  button {
+    border: 0;
+    background: transparent;
+    color: var(--primary-text-color);
+    font: inherit;
+    cursor: pointer;
+    -webkit-tap-highlight-color: transparent;
+  }
+
+  .abugram-mini-toggle {
+    flex: 0 0 auto;
+    width: 42px;
+    height: 42px;
+    border-radius: 50%;
+    background: linear-gradient(160deg, var(--primary-color), color-mix(in srgb, var(--primary-color) 70%, #00d5ff));
+    color: #fff;
+    font-size: 15px;
+    box-shadow: 0 2px 8px color-mix(in srgb, var(--primary-color) 45%, transparent);
+  }
+
+  .abugram-mini-title {
+    flex: 1 1 auto;
+    min-width: 0;
+    overflow: hidden;
+    text-align: start;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+    font-weight: 600;
+    font-size: 15px;
+    letter-spacing: -.01em;
+  }
+
+  .abugram-mini-close {
+    flex: 0 0 auto;
+    width: 30px;
+    height: 30px;
+    font-size: 22px;
+    line-height: 1;
+    color: var(--secondary-text-color);
+  }
+}
